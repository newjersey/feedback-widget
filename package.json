{
  "name": "@newjersey/feedback-widget",
  "version": "0.7.1",
  "description": "Feedback widget to add to a web page, from the New Jersey Office of Innovation",
  "main": "feedback-widget.min.js",
  "scripts": {
    "build": "esbuild feedback-widget.ts --bundle --minify --format=iife --outfile=feedback-widget.min.js",
    "typecheck": "tsc --noEmit",
    "test": "npx jest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjersey/feedback-widget.git"
  },
  "author": "namanaman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/newjersey/feedback-widget/issues"
  },
  "homepage": "https://github.com/newjersey/feedback-widget#readme",
  "files": [
    "feedback-widget.min.js"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "lint-staged": "^17.4.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "npm run test"
    ]
  }
}
